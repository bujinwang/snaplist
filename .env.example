# Copy to .env and fill in. Never commit .env.
# Nothing here has a default in code: an empty value means "not configured",
# and GET /readyz reports which names are empty (never the values).
# Which epic each one unblocks: docs/RUNBOOK.md section 7.

ENV=local
LOG_LEVEL=info

# --- Supabase (E5, E6-T1, E8-T3) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Stripe (E8-T1, E8-T2, E7-T5) ---
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Virtual try-on, FASHN (E4-T1, E4-T3) ---
FASHN_API_KEY=

# --- Modal GPU jobs (E5-T3 deploy, E4-T2) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Attributes VLM (E3-T2): DeepSeek V4.1 Flash, chosen 2026-11-04, ADR-006 ---
# base_url has NO /v1: the adapter appends /chat/completions itself.
# The API model id is `deepseek-flash` (served by DeepSeek-V4.1-Flash-1017), NOT
# "deepseek-v4.1-flash" -- that is a marketing name, not a valid model id.
SNAPLIST_ATTRS_PROVIDER=http
SNAPLIST_VLM_BASE_URL=https://api.deepseek.com
SNAPLIST_VLM_MODEL=deepseek-flash
VLM_API_KEY=
# DeepSeek-specific knobs, kept in config so swapping providers is not a code change.
# thinking is ON by default and would emit chain-of-thought + ignore temperature; JSON mode
# needs response_format; max_tokens prevents a truncated JSON object.
SNAPLIST_VLM_EXTRA_BODY={"thinking":{"type":"disabled"},"response_format":{"type":"json_object"},"max_tokens":1024}
