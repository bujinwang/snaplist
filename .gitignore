# python
.venv/
.venv-gen/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# node
node_modules/
.pnpm-store/
.expo/
dist/
apps/mobile/dist/
apps/mobile/.expo/
*.tsbuildinfo

# env / secrets
.env
.env.*
!.env.example

# research data — personal data, never committed.
# Recordings, ASR transcripts and quotes attributable to a real person live ONLY here
# (docs/METRICS.md §4 rule 7). Deliberately no .gitkeep: the directory itself must not be
# tracked, so a fresh clone has no path to accidentally commit into.
docs/research/

# os / editor
.DS_Store
.idea/
.vscode/

# generated eval artifacts (reports are regenerated; golden binaries are NEVER committed)
evals/reports/*
!evals/reports/.gitkeep
logs/*
!logs/.gitkeep

# copyright-frozen golden binaries — NEVER commit (ADR-010 §3, evals/golden/SOURCING.md:30-32)
evals/golden/photos/*
!evals/golden/photos/.gitkeep
evals/golden/masks/*
!evals/golden/masks/.gitkeep
evals/golden/masks_draft/*
evals/golden/manifest.json

# NOTE: uv.lock and pnpm-lock.yaml are always committed — reproducible installs.
